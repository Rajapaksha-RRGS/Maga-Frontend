generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═════════════════════════════════════════════════════════════════════════════
// LEVEL 1: GLOBAL / CORPORATE MASTER DATA & HEAD OFFICE
// ═════════════════════════════════════════════════════════════════════════════

model SuperAdmin {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("MF_G_SUPER_ADMIN")
}

// ─────────────────────────────────────────────────────────────────────────────
// UNIFIED PROJECT / SITE ENTITY (Merged CorporateProject + Tenant)
// ─────────────────────────────────────────────────────────────────────────────
model Project {
  id             String   @id @default(uuid())
  projectCode    String   @unique @map("project_code") // e.g. "PRJ530", "550", "570"
  projectName    String   @map("project_name")        // e.g. "Kandy Highway Project"
  subdomain      String   @unique                     // e.g. "530" (for site-specific URL/routing)
  description    String?
  searchKey      String?  @map("search_key")
  projectManager String?  @map("project_manager")
  addressCode    String?  @map("address_code")
  enterpriseUnit String?  @map("enterprise_unit")
  currency       String   @default("LKR")
  addressLine1   String?  @map("address_line1")
  addressLine2   String?  @map("address_line2")
  phone          String?
  fax            String?
  email          String?
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")

  // Site Operations & Resources
  users          User[]
  employees      Employee[]
  equipment      Equipment[]
  activityCodes  ActivityCode[]
  calendarDays   CalendarDay[]
  dailySheets    DailySheet[]
  timeEntries    TimeEntry[]
  transfersFrom  EmployeeTransfer[] @relation("TransfersFrom")
  transfersTo    EmployeeTransfer[] @relation("TransfersTo")

  @@map("MF_PROJECT")
}

model CorporateBusinessPartner {
  id                    String   @id @default(uuid())
  code                  String   @unique
  name                  String
  type                  String   @default("subcontractor")
  contactPerson         String?  @map("contact_person")
  phone                 String?
  email                 String?
  rating                String?
  currentWorkingProject String?  @map("current_working_project")
  status                String   @default("active")
  createdAt             DateTime @default(now()) @map("created_at")

  corporateEmployees CorporateEmployee[]
  employees          Employee[]
  equipment          Equipment[]

  @@map("MF_G_BUSINESS_PARTNER")
}

model CorporateTradeGroup {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  standardDailyRate Decimal  @default(1400.00) @map("standard_daily_rate") @db.Decimal(10, 2)
  standardOtRate    Decimal? @map("standard_ot_rate") @db.Decimal(10, 2)
  status            String   @default("active")
  createdAt         DateTime @default(now()) @map("created_at")

  corporateEmployees CorporateEmployee[]
  employees          Employee[]

  @@map("MF_G_TRADE_GROUP")
}

model UnitMaster {
  id        String   @id @default(uuid())
  code      String   @unique // "Days", "Hrs", "EX.hrs", "mth", "m2", "km"
  name      String
  category  String   @default("meter")
  createdAt DateTime @default(now()) @map("created_at")

  equipmentMeterUnit Equipment[]         @relation("EquipmentMeterUnit")
  equipmentDailyLogs EquipmentDailyLog[]

  @@map("MF_G_UNIT_MASTER")
}

model DayType {
  id             String   @id @default(uuid())
  code           String   @unique // "NORMAL", "POYA", "SUNDAY", "SPECIAL"
  name           String
  rateMultiplier Decimal  @default(1.00) @map("rate_multiplier") @db.Decimal(3, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  calendarDays CalendarDay[]
  timeEntries  TimeEntry[]

  @@map("MF_G_DAY_TYPE")
}

model CorporateEmployee {
  id                         String   @id @default(uuid())
  employeeCode               String   @unique @map("employee_code")
  fullName                   String   @map("full_name")
  nicNo                      String   @map("nic_no")
  tradeGroupId               String?  @map("trade_group_id")
  dailyRate                  Decimal? @map("daily_rate") @db.Decimal(12, 2)
  isOperator                 Boolean  @default(false) @map("is_operator")
  epfNo                      String?  @map("epf_no")
  corporateBusinessPartnerId String?  @map("corporate_business_partner_id")
  currentWorkingProject      String?  @map("current_working_project")
  status                     String   @default("active")
  createdAt                  DateTime @default(now()) @map("created_at")

  tradeGroup               CorporateTradeGroup?      @relation(fields: [tradeGroupId], references: [id])
  corporateBusinessPartner CorporateBusinessPartner? @relation(fields: [corporateBusinessPartnerId], references: [id])
  projectEmployees         Employee[]
  transfers                EmployeeTransfer[]

  @@index([tradeGroupId])
  @@index([corporateBusinessPartnerId])
  @@map("MF_G_EMPLOYEE")
}

model CorporateEquipment {
  id                      String   @id @default(uuid())
  standardEquipmentNumber String   @map("standard_equipment_number")
  equipmentName           String   @map("equipment_name")
  condition               String   @default("DRY")
  unit                    String   @default("hrs")
  minimumUtilization      Decimal? @map("minimum_utilization") @db.Decimal(10, 2)
  dailyRate               Decimal  @default(0.00) @map("daily_rate") @db.Decimal(12, 2)
  businessPartner         String?  @map("business_partner")
  vehicleNo               String?  @map("vehicle_no")
  description             String?
  searchKey               String?  @map("search_key")
  costRate                Decimal  @default(0.00) @map("cost_rate") @db.Decimal(12, 2)
  currency                String   @default("LKR")
  type                    String?
  currentWorkingProject   String?  @map("current_working_project")
  status                  String   @default("active")
  createdAt               DateTime @default(now()) @map("created_at")

  projectEquipment Equipment[]

  @@index([standardEquipmentNumber])
  @@index([vehicleNo])
  @@map("MF_G_EQUIPMENT")
}

model CorporateActivityCode {
  id          String   @id @default(uuid())
  code        String   @unique
  description String
  unit        String?
  createdAt   DateTime @default(now()) @map("created_at")

  activityCodes ActivityCode[]

  @@map("MF_G_ACTIVITY_CODE")
}

// ─────────────────────────────────────────────────────────────────────────────
// EMPLOYEE TRANSFER LEDGER (Project-to-Project Transfers)
// ─────────────────────────────────────────────────────────────────────────────
model EmployeeTransfer {
  id                  String    @id @default(uuid())
  corporateEmployeeId String    @map("corporate_employee_id")
  fromProjectId       String?   @map("from_project_id")
  toProjectId         String    @map("to_project_id")
  startDate           DateTime  @map("start_date") @db.Date
  endDate             DateTime? @map("end_date") @db.Date
  status              String    @default("active") // "active" | "transferred" | "released"
  remarks             String?
  createdAt           DateTime  @default(now()) @map("created_at")

  corporateEmployee CorporateEmployee @relation(fields: [corporateEmployeeId], references: [id], onDelete: Cascade)
  fromProject       Project?          @relation("TransfersFrom", fields: [fromProjectId], references: [id])
  toProject         Project           @relation("TransfersTo", fields: [toProjectId], references: [id])

  @@index([corporateEmployeeId])
  @@index([fromProjectId])
  @@index([toProjectId])
  @@index([toProjectId, startDate, endDate])
  @@map("MF_G_EMPLOYEE_TRANSFER")
}

// ═════════════════════════════════════════════════════════════════════════════
// LEVEL 2: PROJECT / SITE OPERATIONAL MASTER DATA (MF_L_*)
// ═════════════════════════════════════════════════════════════════════════════

model User {
  id                 String   @id @default(uuid())
  projectId          String   @map("project_id")
  username           String
  passwordHash       String   @map("password_hash")
  fullName           String   @map("full_name")
  role               String   // "admin" | "supervisor"
  employeeId         String?  @map("employee_id")
  mustChangePassword Boolean  @default(true) @map("must_change_password")
  phone              String?
  status             String   @default("active")
  createdAt          DateTime @default(now()) @map("created_at")

  project               Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dailySheets         DailySheet[]
  timeEntriesRecorded TimeEntry[]  @relation("TimeEntryRecordedBy")

  @@unique([projectId, username])
  @@index([projectId])
  @@map("MF_L_USER")
}

model Employee {
  id                  String   @id @default(uuid())
  projectId           String   @map("project_id")
  corporateEmployeeId String   @map("corporate_employee_id")
  callingName         String?  @map("calling_name")
  tradeGroupId        String?  @map("trade_group_id")
  businessPartnerId   String?  @map("business_partner_id")
  dailyRate           Decimal  @default(1400.00) @map("daily_rate") @db.Decimal(10, 2)
  isOperator          Boolean  @default(false) @map("is_operator")
  status              String   @default("active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  project              Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  corporateEmployee    CorporateEmployee          @relation(fields: [corporateEmployeeId], references: [id])
  tradeGroup           CorporateTradeGroup?       @relation(fields: [tradeGroupId], references: [id])
  businessPartner      CorporateBusinessPartner?  @relation(fields: [businessPartnerId], references: [id])
  assignments          DailyAssignment[]
  operatorAssignments DailyEquipmentAssignment[] @relation("OperatorAssigned")
  timeEntries          TimeEntry[]

  @@unique([projectId, corporateEmployeeId])
  @@index([projectId])
  @@index([corporateEmployeeId])
  @@index([tradeGroupId])
  @@index([businessPartnerId])
  @@map("MF_L_EMPLOYEE")
}

model Equipment {
  id                   String   @id @default(uuid())
  projectId            String   @map("project_id")
  corporateEquipmentId String   @map("corporate_equipment_id")
  condition            String   @default("DRY")
  costRate             Decimal? @default(0.00) @map("cost_rate") @db.Decimal(10, 2)
  status               String   @default("active")
  meterUnitCode        String?  @map("meter_unit_code")
  ownerPartnerId       String?  @map("owner_partner_id")
  createdAt            DateTime @default(now()) @map("created_at")

  project            Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  corporateEquipment CorporateEquipment         @relation(fields: [corporateEquipmentId], references: [id])
  meterUnit          UnitMaster?                @relation("EquipmentMeterUnit", fields: [meterUnitCode], references: [code])
  ownerPartner       CorporateBusinessPartner?  @relation(fields: [ownerPartnerId], references: [id])
  dailyAssignments   DailyEquipmentAssignment[]
  timeEntries        TimeEntry[]

  @@unique([projectId, corporateEquipmentId])
  @@index([projectId])
  @@index([corporateEquipmentId])
  @@index([meterUnitCode])
  @@index([ownerPartnerId])
  @@map("MF_L_EQUIPMENT")
}

model ActivityCode {
  id                      String   @id @default(uuid())
  projectId               String   @map("project_id")
  corporateActivityCodeId String?  @map("corporate_activity_code_id")
  code                    String
  description             String?
  unit                    String?
  createdAt               DateTime @default(now()) @map("created_at")

  project                     Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  corporateActivityCode       CorporateActivityCode?      @relation(fields: [corporateActivityCodeId], references: [id])
  timeEntries                 TimeEntry[]
  activitySplits              LaborActivitySplit[]
  equipmentDailyLogActivities EquipmentDailyLogActivity[]

  @@unique([projectId, code])
  @@index([projectId])
  @@index([corporateActivityCodeId])
  @@map("MF_L_ACTIVITY_CODE")
}

model CalendarDay {
  projectId String   @map("project_id")
  date      DateTime @db.Date
  dayTypeId String   @map("day_type_id")
  remarks   String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dayType DayType @relation(fields: [dayTypeId], references: [id])

  @@id([projectId, date])
  @@index([projectId])
  @@index([dayTypeId])
  @@map("MF_L_CALENDAR")
}

// ═════════════════════════════════════════════════════════════════════════════
// LEVEL 3: DAILY OPERATIONAL TRANSACTIONS (MF_L_*)
// ═════════════════════════════════════════════════════════════════════════════

model DailySheet {
  id           String    @id @default(uuid())
  projectId    String    @map("project_id")
  date         DateTime  @db.Date
  supervisorId String    @map("supervisor_id")
  siteCode     String?   @map("site_code")
  status       String    @default("draft")
  isLocked     Boolean   @default(false) @map("is_locked")
  submittedAt  DateTime? @map("submitted_at")
  approvedAt   DateTime? @map("approved_at")
  approvedById String?   @map("approved_by_id")
  remarks      String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  project              Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supervisor           User                       @relation(fields: [supervisorId], references: [id])
  assignments          DailyAssignment[]
  equipmentAssignments DailyEquipmentAssignment[]
  timeEntries          TimeEntry[]

  @@unique([projectId, supervisorId, date])
  @@index([projectId, date])
  @@index([supervisorId])
  @@map("MF_L_DAILY_SHEET")
}

model DailyAssignment {
  id           String   @id @default(uuid())
  dailySheetId String   @map("daily_sheet_id")
  employeeId   String   @map("employee_id")
  isStandby    Boolean  @default(false) @map("is_standby")
  createdAt    DateTime @default(now()) @map("created_at")

  dailySheet DailySheet @relation(fields: [dailySheetId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@unique([dailySheetId, employeeId])
  @@index([dailySheetId])
  @@index([employeeId])
  @@map("MF_L_DAILY_ASSIGNMENT")
}

model DailyEquipmentAssignment {
  id           String   @id @default(uuid())
  dailySheetId String   @map("daily_sheet_id")
  equipmentId  String   @map("equipment_id")
  operatorId   String   @map("operator_id")
  createdAt    DateTime @default(now()) @map("created_at")

  dailySheet DailySheet         @relation(fields: [dailySheetId], references: [id], onDelete: Cascade)
  equipment  Equipment          @relation(fields: [equipmentId], references: [id])
  operator   Employee           @relation("OperatorAssigned", fields: [operatorId], references: [id])
  dailyLog   EquipmentDailyLog?

  @@unique([dailySheetId, operatorId, equipmentId])
  @@index([dailySheetId])
  @@index([equipmentId])
  @@index([operatorId])
  @@map("MF_L_DAILY_EQUIPMENT_ASSIGNMENT")
}

model EquipmentDailyLog {
  id               String   @id @default(uuid())
  assignmentId     String   @unique @map("assignment_id")
  
  // Dynamic Units & Total Utilization
  unitCode         String?  @map("unit_code")
  totalUtilization Decimal? @default(0.00) @map("total_utilization") @db.Decimal(8, 2)
  
  // Meter & Running Hours
  initialMeter     Decimal  @default(0.00) @map("initial_meter") @db.Decimal(10, 2)
  finalMeter       Decimal  @default(0.00) @map("final_meter") @db.Decimal(10, 2)
  netRunningHours  Decimal  @default(0.00) @map("net_running_hours") @db.Decimal(6, 2)
  
  // Mileage Running (KM)
  startMileage     Decimal? @default(0.00) @map("start_mileage") @db.Decimal(10, 2)
  endMileage       Decimal? @default(0.00) @map("end_mileage") @db.Decimal(10, 2)
  totalMileage     Decimal? @default(0.00) @map("total_mileage") @db.Decimal(10, 2)
  
  // Operational Time Distribution
  workingHours     Decimal  @default(0.00) @map("working_hours") @db.Decimal(6, 2)
  idleHours        Decimal  @default(0.00) @map("idle_hours") @db.Decimal(6, 2)
  breakdownHours   Decimal  @default(0.00) @map("breakdown_hours") @db.Decimal(6, 2)
  fuelLiters       Decimal  @default(0.00) @map("fuel_liters") @db.Decimal(8, 2)
  remarks          String?
  status           String   @default("draft")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  assignment DailyEquipmentAssignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  activeUnit UnitMaster?                 @relation(fields: [unitCode], references: [code])
  activities EquipmentDailyLogActivity[]

  @@index([unitCode])
  @@map("MF_L_EQUIPMENT_DAILY_LOG")
}

model EquipmentDailyLogActivity {
  id             String   @id @default(uuid())
  dailyLogId     String   @map("daily_log_id")
  activityCodeId String   @map("activity_code_id")
  utilization    Decimal  @default(0.00) @map("utilization") @db.Decimal(8, 2)
  remarks        String?
  createdAt      DateTime @default(now()) @map("created_at")

  dailyLog     EquipmentDailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  activityCode ActivityCode      @relation(fields: [activityCodeId], references: [id])

  @@index([dailyLogId])
  @@index([activityCodeId])
  @@map("MF_L_EQUIPMENT_DAILY_LOG_ACTIVITY")
}

model TimeEntry {
  id                 String    @id @default(uuid())
  projectId          String    @map("project_id")
  dailySheetId       String?   @map("daily_sheet_id")
  employeeId         String    @map("employee_id")
  date               DateTime  @db.Date
  activityId         String    @map("activity_id")
  equipmentId        String?   @map("equipment_id")
  effectiveDayTypeId String    @map("effective_day_type_id")
  inTime             String?   @map("in_time")
  outTime            String?   @map("out_time")
  hours              Decimal   @default(0.00) @db.Decimal(5, 2)
  overtimeHours      Decimal   @default(0.00) @map("overtime_hours") @db.Decimal(5, 2)
  breakHours         Decimal   @default(0.00) @map("break_hours") @db.Decimal(4, 2)
  shiftHours         Decimal?  @map("shift_hours") @db.Decimal(5, 2)
  recordedById       String?   @map("recorded_by_id")
  remarks            String?
  status             String    @default("draft")
  submittedAt        DateTime? @map("submitted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dailySheet       DailySheet?          @relation(fields: [dailySheetId], references: [id], onDelete: Cascade)
  employee         Employee             @relation(fields: [employeeId], references: [id])
  activity         ActivityCode         @relation(fields: [activityId], references: [id])
  equipment        Equipment?           @relation(fields: [equipmentId], references: [id])
  effectiveDayType DayType              @relation(fields: [effectiveDayTypeId], references: [id])
  recordedBy       User?                @relation("TimeEntryRecordedBy", fields: [recordedById], references: [id])
  activitySplits   LaborActivitySplit[]

  @@index([projectId, date])
  @@index([dailySheetId])
  @@index([employeeId])
  @@index([activityId])
  @@index([equipmentId])
  @@index([effectiveDayTypeId])
  @@index([recordedById])
  @@map("MF_L_TIME_ENTRY")
}

model LaborActivitySplit {
  id             String   @id @default(uuid())
  timeEntryId    String   @map("time_entry_id")
  activityCodeId String   @map("activity_code_id")
  hours          Decimal  @default(0.00) @db.Decimal(5, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  timeEntry    TimeEntry    @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  activityCode ActivityCode @relation(fields: [activityCodeId], references: [id])

  @@index([timeEntryId])
  @@index([activityCodeId])
  @@map("MF_L_LABOR_ACTIVITY_SPLIT")
}
